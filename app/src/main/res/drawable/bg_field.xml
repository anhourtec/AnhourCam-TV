<?xml version="1.0" encoding="utf-8"?>
<!-- Text fields: a strong mint ring when focused, so the remote's position is always obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FF0B0E12" />
            <stroke android:width="3dp" android:color="#FFC8FBD0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#FF0B0E12" />
            <stroke android:width="1dp" android:color="#FF2C343E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
