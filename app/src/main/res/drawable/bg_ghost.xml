<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: outline; mint fill when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#33C8FBD0" />
            <stroke android:width="3dp" android:color="#FFC8FBD0" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <stroke android:width="1dp" android:color="#FF2C343E" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
