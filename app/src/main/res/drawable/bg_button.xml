<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: mint pill; brighter with a white ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#FF3A4A40" /><corners android:radius="999dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFE2FFE6" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape><solid android:color="#FFC8FBD0" /><corners android:radius="999dp" /></shape>
    </item>
</selector>
