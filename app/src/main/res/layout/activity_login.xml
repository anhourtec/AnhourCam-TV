<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in: phone pairing (left, primary) and on-TV form (right). Explicit D-pad focus order. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="24dp">

        <!-- Top bar: brand + language -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/language"
                style="@style/GhostButton"
                android:nextFocusDown="@id/email"
                android:nextFocusLeft="@id/new_code" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="28dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Phone pairing -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="48dp">

                <TextView style="@style/Eyebrow" android:text="@string/phone_eyebrow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/phone_title"
                    android:textColor="@color/text"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pair_step1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/phone_step1"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pair_url"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/accent"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pair_step2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/phone_step2"
                    android:textColor="@color/text_dim"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pair_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.25"
                    android:paddingStart="24dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/text"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pair_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/phone_note"
                    android:textColor="#FF6B7682"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/new_code"
                    style="@style/GhostButton"
                    android:layout_marginTop="12dp"
                    android:nextFocusRight="@id/email"
                    android:nextFocusUp="@id/language"
                    android:text="@string/phone_new_code"
                    android:visibility="gone" />

                <!-- No BitVision account: the app also works with IP cameras alone (Phase 6). -->
                <Button
                    android:id="@+id/ip_only"
                    style="@style/GhostButton"
                    android:layout_marginTop="28dp"
                    android:nextFocusRight="@id/sign_in"
                    android:nextFocusUp="@id/new_code"
                    android:text="@string/login_ip_only" />
            </LinearLayout>

            <!-- On-TV form -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_title"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/email"
                    style="@style/Field"
                    android:layout_marginTop="14dp"
                    android:autofillHints="emailAddress"
                    android:hint="@string/login_email"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:inputType="textEmailAddress"
                    android:nextFocusDown="@id/password"
                    android:nextFocusLeft="@id/new_code"
                    android:nextFocusUp="@id/language" />

                <EditText
                    android:id="@+id/password"
                    style="@style/Field"
                    android:autofillHints="password"
                    android:hint="@string/login_password"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:inputType="textPassword"
                    android:nextFocusDown="@id/new_captcha"
                    android:nextFocusUp="@id/email" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/captcha"
                        android:layout_width="150dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_captcha"
                        android:contentDescription="@string/login_captcha_description"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />

                    <Button
                        android:id="@+id/new_captcha"
                        style="@style/GhostButton"
                        android:layout_marginStart="14dp"
                        android:nextFocusDown="@id/code"
                        android:nextFocusUp="@id/password"
                        android:text="@string/login_new_image" />
                </LinearLayout>

                <EditText
                    android:id="@+id/code"
                    style="@style/Field"
                    android:hint="@string/login_captcha_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:nextFocusDown="@id/sign_in"
                    android:nextFocusUp="@id/new_captcha" />

                <Button
                    android:id="@+id/sign_in"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="18dp"
                    android:nextFocusUp="@id/code"
                    android:nextFocusLeft="@id/ip_only"
                    android:text="@string/login_sign_in" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFB4AB"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
